//! The Rust kernel of `$name`: <replace with what it does, in one line>.
//! This file is the whole effect: the Python registry builds `fx.$name`, its model and its documentation from `Params`
//! below, so there is no Python folder to write. What it does is documented once, on `Params`.

use serde::Deserialize;

use crate::effect::{Category, Meta};
use crate::params::Params;
use crate::{Footprint, Image, Inputs, Picture};

// What the effect declares besides its parameters: its section of the catalogue, the opacity of a step of it that sets
// none (below 1 for an effect meant to be mixed in partway) and the inputs it takes (none yet: list `Input::Partition`
// or `Input::SizeRatio` to receive them in `render`'s `inputs`).
pub(crate) const META: Meta = Meta {
    category: Category::$Category,
    opacity: 1.0,
    inputs: &[],
};

// What the effect reads around a pixel, for these parameters: `Footprint::Pixel` (nothing but the pixel itself, as here),
// `Footprint::Radius(r)` (rows up to `r` design px away: a blur's radius, a displacement's amount) or `Footprint::Whole`
// (anything else: an effect that knows where a pixel is in the picture, its height, or a statistic of all of it, or
// when unsure). `crates/core/tests/it/footprint.rs` renders bands of rows with their margin and fails a claim that is
// less than the truth.
pub(crate) fn footprint(_params: &Params) -> Footprint {
    Footprint::Pixel
}

// The parameters are declared once, here: each field's `///` doc comment and `#[param(..)]` make its description,
// default and range, and the Python model is built from them. Replace the example
// field. Every field has a doc (what it does, its unit and range in words, what raising it does) and a default. A
// number (`f32`, or `i32` for a whole number) also has a `unit` (px, fraction, degrees, stops, count, ratio, cycles,
// density) and an inclusive `min` and `max` that hold the default; `drivable` (only an `f32`), `advanced` and `cyclic`
// (degrees, min to max one turn) are flags. `bool`, `Color` (`default = "#rrggbb"`) and a `#[derive(Choice)]` enum
// (`default = Variant`; the doc names every variant) take no unit or range. Names are the field's own terms (radius,
// amount, threshold, angle, seed...), never strength, intensity or factor. A broken declaration fails the build, naming the field
// (an unknown unit shows as rustc's own error, and the doc must name every variant: Python checks that on import).
// Options of every library call are fields too; a constant is allowed only for a standard (Rec. 709, sRGB...) or a pure
// guard (an epsilon), with a `// constant: <citation or reason>` comment (a test fails on any other number). The doc
// comment of the struct says what the parameters are as a whole: it is the model's docstring, and a field's doc is its
// help text in Python: plain text, no rustdoc links, and a blank `///` line becomes a double space. Keep the struct,
// its fields and a choice enum `pub`: users build a step from them (`Step::of`). A parameter `render` never reads fails
// `crates/core/tests/parameters_are_read.rs`; one that matters only while another is set needs a row in that test's
// `conditional`.

// Replace the doc below with what the effect does, for its users (`help(fx.$name)`, the catalogue): its first sentence
// is the summary, then what each step does and in which order. An effect is a pure function: a float32 RGB picture in
// 0..1 in, a new picture of the same shape and range out, the same for the same values, the input never modified.

/// Mix the picture toward its negative by `amount`.
#[derive(Debug, Clone, PartialEq, Deserialize, Params)]
#[serde(deny_unknown_fields)]
pub struct Params {
    /// How far the picture is mixed toward its negative: 0 = unchanged, 1 = fully inverted.
    #[param(default = 1.0, unit = fraction, min = 0, max = 1)]
    pub amount: f32,
}

/// The picture mixed toward its negative by `amount`. Replace with the effect: pixel by pixel as here, or over the
/// whole picture. Every number is a `Params` field, a trivial operand, or carries `// constant: <reason>`; what two
/// effects share goes in `crate::ops`, never in another effect's file. `inputs` holds only the inputs `META` declares
/// (rename it when `render` reads it).
pub(crate) fn render(picture: &Picture<'_>, params: &Params, _inputs: &Inputs<'_>) -> Image {
    picture.map(|pixel| pixel.map(|value| value * (1.0 - params.amount) + (1.0 - value) * params.amount))
}
