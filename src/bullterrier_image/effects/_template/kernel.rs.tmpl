//! The Rust kernel of `$name`: <replace with what it does, in one line>.
//! What it does is documented once, on the Python effect, whose body runs this through the core (`_core.apply`):
//! `src/bullterrier_image/effects/$name/effect.py`. Its parameters are declared here.

use serde::Deserialize;

use crate::effect::{Category, Meta};
use crate::params::Params;
use crate::{Image, Picture};

// What the effect declares besides its parameters: its section of the catalogue, the opacity of a step of it that sets
// none (below 1 for an effect meant to be mixed in partway) and the inputs it takes (none yet).
pub(crate) const META: Meta = Meta {
    category: Category::$Category,
    opacity: 1.0,
    inputs: &[],
};

// The parameters are declared once, here: each field's `///` doc comment and `#[param(..)]` make its description,
// default and range, and the Python model is built from them (`${Name}Params` in effect.py). Replace the example
// field. Every field has a doc (what it does, its unit and range in words, what raising it does) and a default. A
// number (`f32`, or `i32` for a whole number) also has a `unit` (px, fraction, degrees, stops, count, ratio, cycles,
// density) and an inclusive `min` and `max` that hold the default; `drivable` (only an `f32`), `advanced` and `cyclic`
// (degrees, min to max one turn) are flags. `bool`, `Color` (`default = "#rrggbb"`) and a `#[derive(Choice)]` enum
// (`default = Variant`; the doc names every variant) take no unit or range. Names are the field's own terms (radius,
// amount, threshold, angle, seed...), never strength, intensity or factor. A broken declaration fails the build, naming the field
// (an unknown unit shows as rustc's own error, and the doc must name every variant: Python checks that on import).
// Options of every library call are fields too; a constant is allowed only for a standard (Rec. 709, sRGB...) or a pure
// guard (an epsilon), with a `// constant: <citation or reason>` comment (a test fails on any other number). The doc
// comment of the struct says what the parameters are as a whole: it is the model's docstring, and a field's doc is its
// help text in Python: plain text, no rustdoc links, and a blank `///` line becomes a double space. Keep the struct and
// its fields `pub(crate)`. A parameter `render` never reads fails `crates/core/tests/parameters_are_read.rs`; one that
// matters only while another is set needs a row in that test's `conditional`.

/// The settings of `$name`: every value that shapes its result.
#[derive(Deserialize, Params)]
#[serde(deny_unknown_fields)]
pub(crate) struct Params {
    /// How far the picture is mixed toward its negative: 0 = unchanged, 1 = fully inverted.
    #[param(default = 1.0, unit = fraction, min = 0, max = 1)]
    pub(crate) amount: f32,
}

/// The picture mixed toward its negative by `amount`. Replace with the effect: pixel by pixel as here, or over the
/// whole picture. Every number is a `Params` field, a trivial operand, or carries `// constant: <reason>`; what two
/// effects share goes in `crate::ops`, never in another effect's file.
pub(crate) fn render(picture: &Picture<'_>, params: &Params) -> Image {
    picture.map(|pixel| pixel.map(|value| value * (1.0 - params.amount) + (1.0 - value) * params.amount))
}
