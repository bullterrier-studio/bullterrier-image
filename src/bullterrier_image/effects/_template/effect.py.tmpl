"""The `$name` effect: <replace with what it does, in one line>."""

import numpy as np

from bullterrier_image._native import _core
from bullterrier_image.core.params import EffectParams, param
from bullterrier_image.core.registry import effect


class ${Name}Params(EffectParams):
    """The settings of `$name`: every value that shapes its result."""

    # Replace this example field. Every field has a default and a doc: what it does, its unit and range in words,
    # what raising it does. A number also has a unit and an inclusive min and max that hold the default. Names are
    # the field's own terms (radius, amount, threshold, angle, seed...), never strength, intensity or factor.
    # bool, Literal[...], str and Color fields take no unit, min or max. Options of every library call are fields
    # too; constants are allowed only for standards (Rec. 709, sRGB...) and pure guards (an epsilon), each with a
    # `# constant: <citation or reason>` comment ending its statement or on the line above it (a test fails on any
    # other number, and on any number given to a library call as an option). The kernel's `Params`
    # (crates/core/src/effects/$name.rs) has the same fields, by name.
    amount: float = param(
        1.0,
        unit="fraction",
        min=0,
        max=1,
        doc="How far the picture is mixed toward its negative: 0 = unchanged, 1 = fully inverted.",
    )


# Replace the docstring with what the effect does, for its users (`help(fx.<name>)`, the catalogue): its first
# sentence is the summary. An effect is a pure function: a float32 RGB picture (h, w, 3) in 0..1 in, a new picture of
# the same shape and range out, the same for the same values, the input never modified. The work is done by its Rust
# kernel, which `uv sync` rebuilds after a change; the core takes no map yet, so an effect that works from one (a
# `FieldName` parameter) keeps a Python body for now. The kernel:
# crates/core/src/effects/$name.rs
@effect(category="$category", params=${Name}Params)
def $name(
    rgb: np.ndarray,
    params: ${Name}Params,
) -> np.ndarray:
    """Mix the picture toward its negative by `amount`."""
    return _core.apply("$name", rgb, params.model_dump())
