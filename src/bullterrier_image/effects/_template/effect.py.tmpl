"""The `$name` effect: <replace with what it does, in one line>.

Its parameters are declared by the `Params` struct of its Rust kernel.
"""

import numpy as np

from bullterrier_image._native import _core
from bullterrier_image.core.params import EffectParams
from bullterrier_image.core.registry import effect


# The model is built from the Rust declaration: its fields, docs, defaults and ranges are written there, once, and the
# class body stays empty. An effect that works from a map (a `FieldName` parameter) keeps a Python model for now, with
# `param(...)` fields as `effects/relight/` has.
class ${Name}Params(EffectParams, core="$name"):  # noqa: D101  (documented by its Rust declaration)
    pass


# Replace the docstring with what the effect does, for its users (`help(fx.<name>)`, the catalogue): its first
# sentence is the summary. An effect is a pure function: a float32 RGB picture (h, w, 3) in 0..1 in, a new picture of
# the same shape and range out, the same for the same values, the input never modified. The work is done by its Rust
# kernel, which `uv sync` rebuilds after a change. The kernel:
# crates/core/src/effects/$name.rs
@effect(params=${Name}Params)
def $name(
    rgb: np.ndarray,
    params: ${Name}Params,
) -> np.ndarray:
    """Mix the picture toward its negative by `amount`."""
    return _core.apply("$name", rgb, params.model_dump())
