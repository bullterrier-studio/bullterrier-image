"""Behaviour of the `$name` effect."""

# Replace these with the properties that define the effect. Write each case as a row of a table: the input, the
# setting and the expected value worked out by hand (never with the effect's own formula), with an id that says the
# rule. The contract tests already check every effect's shape, range, determinism, untouched input, parameter limits
# and documentation: do not repeat them here. Shared helpers go in the nearest conftest.py.

import numpy as np
import pytest

from photo_fx.core import registry

NAME = "$name"


@pytest.mark.parametrize(
    ("amount", "expected"),
    [(0.0, 0.2), (0.25, 0.35), (1.0, 0.8)],  # each value of a 0.2 grey moves `amount` of the way to its negative, 0.8
    ids=["amount 0 leaves the picture unchanged", "a quarter of the way", "amount 1 gives the negative"],
)
def test_amount_moves_each_value_toward_its_negative(amount: float, expected: float) -> None:
    grey = np.full((4, 6, 3), 0.2, np.float32)
    np.testing.assert_allclose(registry.apply(NAME, grey, amount=amount), expected, atol=1e-6)


def test_the_negative_of_a_photo_flips_every_channel_on_its_own(photo: np.ndarray) -> None:
    np.testing.assert_allclose(registry.apply(NAME, photo, amount=1.0), 1 - photo, atol=1e-6)
